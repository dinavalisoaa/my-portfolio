nter justify-between bg-white border-4 border-black rounded-xl px-5 py-3 max-w-3xl mx-auto shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]\"><div class=\"w-10 h-10 bg-black rounded-full flex items-center justify-center flex-shrink-0\"><div class=\"w-6 h-6 bg-white rounded-full\"></div></div><div class=\"hidden md:flex items-center gap-6 flex-1 justify-center\"><a href=\"#home\" class=\"text-[16px] font-bold leading-[20px] hover:opacity-70 transition-opacity\">Home</a><a href=\"#experience\" class=\"text-[16px] font-bold leading-[20px] hover:opacity-70 transition-opacity\">Experience</a><a href=\"#skills\" class=\"text-[16px] font-bold leading-[20px] hover:opacity-70 transition-opacity\">Skills</a><a href=\"#portfolio\" class=\"text-[16px] font-bold leading-[20px] hover:opacity-70 transition-opacity\">Portfolio</a><a href=\"#about\" class=\"text-[16px] font-bold leading-[20px] hover:opacity-70 transition-opacity\">About</a></div><a href=\"mailto:randriamifydina@gmail.com\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive py-2 has-[&gt;svg]:px-3 bg-black text-white hover:bg-black/90 rounded-sm px-5 h-12 min-w-[48px] flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail w-10 h-10\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg></button></a></nav></div><div id=\"home\"><section class=\"container mx-auto px-4 py-16 md:py-24\"><div class=\"max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center\"><div class=\"space-y-6\"><h1 class=\"text-[32px] leading-[42px] md:text-[52px] font-bold md:leading-[64px]\">I&#x27;m <span class=\"bg-[#FF6B7A] text-white px-3 py-1 inline-block\">Dina V. Randriamifidy</span>, a Software Engineer</h1><p class=\"text-[#393939] text-[16px] md:text-[18px] font-medium leading-[28px] md:leading-[30px] max-w-xl\">Passionate fullstack developer and AI engineer with 4+ years of experience building FinTech platforms, ERP systems, and AI-powered applications. Currently pursuing Master II MIAGE MBDS at Université de Côte d&#x27;Azur.</p><div class=\"flex flex-col sm:flex-row flex-wrap gap-4 sm:gap-7 pt-4\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive has-[&gt;svg]:px-3 bg-[#0B0B0B] text-white hover:bg-black/90 rounded-lg py-5 px-8 md:py-[22px] md:px-[62px] text-base md:text-lg font-semibold h-auto w-full sm:w-auto sm:min-w-[240px]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail w-5 h-5\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg>Get in touch</button><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive shadow-xs hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 has-[&gt;svg]:px-3 bg-white border-[3px] border-black hover:bg-gray-50 rounded-lg py-5 px-8 md:py-[22px] md:px-[62px] text-base md:text-lg font-semibold h-auto w-full sm:w-auto sm:min-w-[240px]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-folder-open w-5 h-5\"><path d=\"m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2\"></path></svg>View portfolio</button></div></div><div class=\"flex justify-center md:justify-end\"><div class=\"relative w-full max-w-md aspect-square bg-[#FDB927] border-4 border-black rounded-3xl overflow-hidden shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]\"><img src=\"/images/design-mode/63407fbdc2d4ac5270385fd4_home-he.png\" alt=\"Illustrated character avatar\" class=\"w-full h-full object-cover\"/></div></div></div></section></div><div id=\"experience\"><section class=\"bg-black py-16 md:py-24\"><div class=\"container mx-auto px-4\"><div class=\"max-w-7xl mx-auto grid md:grid-cols-[1fr_1.4fr] gap-12 items-start\"><div class=\"text-white pt-0 md:pt-12 md:sticky md:top-12 self-start\"><h2 class=\"text-3xl md:text-4xl lg:text-6xl font-bold mb-6 md:mb-8 leading-[1.3]\">Take a look at my<!-- --> <span class=\"bg-[#6366F1] text-white px-3 py-1 inline-block\">past experience</span></h2><p class=\"text-gray-400 mb-8 md:mb-10 leading-relaxed text-base md:text-lg\">5 years across FinTech, banking, ERP, and AI — building systems that power real businesses and real users.</p><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive has-[&gt;svg]:px-3 bg-white text-black hover:bg-gray-50 rounded-lg py-5 px-8 md:py-[22px] md:px-[62px] text-base md:text-lg font-semibold h-auto w-full sm:w-auto sm:min-w-[240px]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-5 h-5\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg>See full resume</button></div><div class=\"space-y-6\"><div class=\"bg-white border-4 border-black rounded-3xl overflow-hidden\"><div class=\"flex items-center justify-between pt-6 md:pt-8 px-6 md:px-8 pb-4 md:pb-5\"><span class=\"text-sm md:text-base font-black text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black px-3 py-1 rounded-full\">Dec 2024 – Present</span><div class=\"rounded-full border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\"><img alt=\"Ibonia\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full\" style=\"color:transparent\" src=\"/images/agency.png\"/></div></div><div class=\"border-t-[3px] border-black\"></div><div class=\"px-6 md:px-8 pt-5 md:pt-6 pb-6 md:pb-8\"><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-sm font-black text-[#6366F1]\">Ibonia</span><span class=\"text-[#ccc]\">·</span><div class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3 h-3 text-[#aaa]\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-xs text-[#aaa] font-semibold\">Antananarivo, Madagascar</span></div></div><h3 class=\"text-xl md:text-[24px] leading-tight font-black text-[#0B0B0B] mb-4\">Fullstack Developer Java / TypeScript</h3><p class=\"text-[#555] text-sm md:text-base leading-relaxed mb-4\">Working in a FinTech and banking context, building an online payment platform that supports Mobile Money (local services) and international cards (Visa/Mastercard). Designed and built generic payment APIs to unify and centralize mobile money integrations. Also developed an online ticketing and registration engine for trail running events. Applied Domain-Driven Design (DDD) methodology throughout. Optimized and refactored legacy code, created reusable npm libraries, and handled frontend interface design and development.</p><a href=\"https://papi.mg/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 mb-6 text-sm font-bold text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black rounded-lg px-3 py-1.5 hover:bg-[#FFC224] transition-colors\"><svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\"></path></svg>papi.mg</a><div class=\"border-t-2 border-dashed border-[#E0E0E0] mb-5\"></div><div class=\"flex flex-wrap gap-2\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg\" alt=\"Java\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Java</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg\" alt=\"Spring\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Spring</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg\" alt=\"Next.js\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Next.js</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg\" alt=\"TypeScript\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>TypeScript</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/junit5/25A162\" alt=\"JUnit\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>JUnit</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg\" alt=\"Docker\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Docker</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/gitlab/gitlab-original.svg\" alt=\"GitLab\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>GitLab</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg\" alt=\"MySQL\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>MySQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/tailwindcss/06B6D4\" alt=\"Tailwind\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Tailwind</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/mui/007FFF\" alt=\"MUI\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>MUI</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">WebSocket</span></div></div></div><div class=\"bg-white border-4 border-black rounded-3xl overflow-hidden\"><div class=\"flex items-center justify-between pt-6 md:pt-8 px-6 md:px-8 pb-4 md:pb-5\"><span class=\"text-sm md:text-base font-black text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black px-3 py-1 rounded-full\">Jul 2025 – Jan 2026</span><div class=\"rounded-full border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\"><img alt=\"Freelance — Romania\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full\" style=\"color:transparent\" src=\"/images/company.png\"/></div></div><div class=\"border-t-[3px] border-black\"></div><div class=\"px-6 md:px-8 pt-5 md:pt-6 pb-6 md:pb-8\"><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-sm font-black text-[#6366F1]\">Freelance — Romania</span><span class=\"text-[#ccc]\">·</span><div class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3 h-3 text-[#aaa]\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-xs text-[#aaa] font-semibold\">Remote</span></div></div><h3 class=\"text-xl md:text-[24px] leading-tight font-black text-[#0B0B0B] mb-4\">Fullstack Developer / AI Engineer</h3><p class=\"text-[#555] text-sm md:text-base leading-relaxed mb-4\">Built an AI system that automatically classifies incoming emails and extracts key information from their content. Created an AI agent capable of generating contextualized reply suggestions by cross-referencing client requests against a real-time availability database. Integrated third-party APIs (FareHarbor, Ebriza) to enrich request context. Used Supabase to store all exchanges, requests, and AI-generated outputs. Handled both backend and frontend development, and migrated the company website from Wix CMS to Next.js + TinaCMS.</p><div class=\"border-t-2 border-dashed border-[#E0E0E0] mb-5\"></div><div class=\"flex flex-wrap gap-2\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg\" alt=\"Next.js\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Next.js</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg\" alt=\"React\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>React</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg\" alt=\"TypeScript\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>TypeScript</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/supabase/3ECF8E\" alt=\"Supabase\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Supabase</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/openai/000000\" alt=\"OpenAI\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>OpenAI</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/stripe/635BFF\" alt=\"Stripe\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Stripe</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">SQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">LLMs</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">Directus</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">TinaCMS</span></div></div></div><div class=\"bg-white border-4 border-black rounded-3xl overflow-hidden\"><div class=\"flex items-center justify-between pt-6 md:pt-8 px-6 md:px-8 pb-4 md:pb-5\"><span class=\"text-sm md:text-base font-black text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black px-3 py-1 rounded-full\">Jan 2024 – Dec 2024</span><div class=\"rounded-full border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\"><img alt=\"eTech Consulting\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full\" style=\"color:transparent\" src=\"/images/busines.png\"/></div></div><div class=\"border-t-[3px] border-black\"></div><div class=\"px-6 md:px-8 pt-5 md:pt-6 pb-6 md:pb-8\"><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-sm font-black text-[#6366F1]\">eTech Consulting</span><span class=\"text-[#ccc]\">·</span><div class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3 h-3 text-[#aaa]\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-xs text-[#aaa] font-semibold\">Antananarivo, Madagascar</span></div></div><h3 class=\"text-xl md:text-[24px] leading-tight font-black text-[#0B0B0B] mb-4\">Software Engineer</h3><p class=\"text-[#555] text-sm md:text-base leading-relaxed mb-4\">Worked on ERP applications using Python and the Odoo framework. Key contributions included integrating an AI-powered OCR module into Odoo for automatic data extraction from scanned documents. Also contributed to the development of HR, Payroll, and Invoicing management modules, and designed an internal book reservation platform used by all group employees.</p><div class=\"border-t-2 border-dashed border-[#E0E0E0] mb-5\"></div><div class=\"flex flex-wrap gap-2\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg\" alt=\"Python\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Python</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/fastapi/fastapi-original.svg\" alt=\"FastAPI\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>FastAPI</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg\" alt=\"PostgreSQL\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>PostgreSQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/odoo/714B67\" alt=\"Odoo\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Odoo</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/jenkins/jenkins-original.svg\" alt=\"Jenkins\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Jenkins</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/gitlab/gitlab-original.svg\" alt=\"GitLab\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>GitLab</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">XML</span></div></div></div><div class=\"bg-white border-4 border-black rounded-3xl overflow-hidden\"><div class=\"flex items-center justify-between pt-6 md:pt-8 px-6 md:px-8 pb-4 md:pb-5\"><span class=\"text-sm md:text-base font-black text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black px-3 py-1 rounded-full\">2023 – Jan 2024</span><div class=\"rounded-full border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\"><img alt=\"BICI\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full\" style=\"color:transparent\" src=\"/images/startup.png\"/></div></div><div class=\"border-t-[3px] border-black\"></div><div class=\"px-6 md:px-8 pt-5 md:pt-6 pb-6 md:pb-8\"><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-sm font-black text-[#6366F1]\">BICI</span><span class=\"text-[#ccc]\">·</span><div class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3 h-3 text-[#aaa]\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-xs text-[#aaa] font-semibold\">Antananarivo, Madagascar</span></div></div><h3 class=\"text-xl md:text-[24px] leading-tight font-black text-[#0B0B0B] mb-4\">Software Developer Java</h3><p class=\"text-[#555] text-sm md:text-base leading-relaxed mb-4\">Developed ERP applications in a Java/JEE environment, including dock management for SPAT, payroll, and invoicing. Designed a CRUD interface generation engine compatible with Oracle, MySQL, and PostgreSQL database structures — a significant internal tool. Also built a database management interface inspired by DBeaver but simplified for non-technical users. Handled database administration tickets (Oracle and PostgreSQL) and supported end-users in adopting applications.</p><div class=\"border-t-2 border-dashed border-[#E0E0E0] mb-5\"></div><div class=\"flex flex-wrap gap-2\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg\" alt=\"Java\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Java</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg\" alt=\"Spring\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Spring</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg\" alt=\"JavaScript\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>JavaScript</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/oracle/oracle-original.svg\" alt=\"Oracle\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>Oracle</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg\" alt=\"MySQL\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>MySQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg\" alt=\"PostgreSQL\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>PostgreSQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">JEE</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">WildFly</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">JSP</span></div></div></div><div class=\"bg-white border-4 border-black rounded-3xl overflow-hidden\"><div class=\"flex items-center justify-between pt-6 md:pt-8 px-6 md:px-8 pb-4 md:pb-5\"><span class=\"text-sm md:text-base font-black text-[#0B0B0B] bg-[#F0F0F0] border-2 border-black px-3 py-1 rounded-full\">Jun 2022 – Jun 2023</span><div class=\"rounded-full border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\"><img alt=\"Freelance\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full\" style=\"color:transparent\" src=\"/images/agency.png\"/></div></div><div class=\"border-t-[3px] border-black\"></div><div class=\"px-6 md:px-8 pt-5 md:pt-6 pb-6 md:pb-8\"><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-sm font-black text-[#6366F1]\">Freelance</span><span class=\"text-[#ccc]\">·</span><div class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-3 h-3 text-[#aaa]\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-xs text-[#aaa] font-semibold\">Antananarivo, Madagascar</span></div></div><h3 class=\"text-xl md:text-[24px] leading-tight font-black text-[#0B0B0B] mb-4\">Fullstack Developer</h3><p class=\"text-[#555] text-sm md:text-base leading-relaxed mb-4\">Co-designed and built a school management application covering course and grade management, school fee calculation, report card printing, and deployment on an internal network.</p><div class=\"border-t-2 border-dashed border-[#E0E0E0] mb-5\"></div><div class=\"flex flex-wrap gap-2\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg\" alt=\"PHP\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>PHP</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.simpleicons.org/codeigniter/EE4323\" alt=\"CodeIgniter\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>CodeIgniter</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg\" alt=\"PostgreSQL\" width=\"14\" height=\"14\" class=\"w-3.5 h-3.5 object-contain\"/>PostgreSQL</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">AJAX</span><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E0E0E0] rounded-lg px-2.5 py-1 text-[11px] font-bold text-[#333] hover:border-black transition-colors\">FPDF</span></div></div></div></div></div></div></section></div><div id=\"skills\"><section class=\"bg-white py-16 md:py-24\"><div class=\"container mx-auto px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"text-center mb-12 md:mb-16\"><h2 class=\"text-4xl md:text-[52px] md:leading-[60px] font-bold mb-4\">My broad <span class=\"bg-[#FF4A60] text-white px-3 py-1 inline-block\">set of skills</span></h2><p class=\"text-[#393939] text-base md:text-lg font-medium leading-relaxed md:leading-[30px] max-w-2xl mx-auto\">From backend APIs to AI models and ERP systems — full-stack capabilities across the entire software lifecycle.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"bg-white border-[3px] border-black rounded-[32px] overflow-hidden hover:translate-y-[-4px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex flex-col group\"><div class=\"mb-5 -mx-[3px] -mt-[3px] overflow-hidden rounded-t-[29px] h-36\"><img alt=\"Backend Development\" loading=\"lazy\" width=\"382\" height=\"144\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover rounded-t-[29px] group-hover:scale-110 transition-transform duration-500 ease-out\" style=\"color:transparent\" src=\"/images/web-design.svg\"/></div><div class=\"px-8 pb-8 flex-1 flex flex-col\"><h3 class=\"text-[24px] leading-[34px] font-bold mb-3 text-[#0B0B0B]\">Backend Development</h3><p class=\"text-[16px] leading-[26px] font-medium text-[#393939] mb-5 flex-1\">Java Spring Boot, FastAPI, Node.js, PHP — REST APIs, microservices, and domain-driven design for scalable systems.</p><div class=\"flex flex-wrap gap-2 pt-4 border-t-2 border-dashed border-[#E8E8E8]\"><span class=\"inline-flex items-center gap-1.5 bg-[#F8F8F8] border-2 border-[#E8E8E8] rounded-lg px-2 py-1 text-[11px] font-bold text-[#444] hover:border-black transition-colors\"><img src=\"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg\" alt=\"Java\" class=\"w-3.5 h-3.5 object-contain\"/>Java</span><span class=\"inline-flex items-center gap